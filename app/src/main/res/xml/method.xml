<?xml version="1.0" encoding="utf-8"?>
<!--
  Both languages are turned on by default (overridesImplicitlyEnabledSubtype), so the
  system keyboard picker lists WSwipe > ไทย and WSwipe > English whatever the phone's
  language is.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.wow.wswipe.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/subtype_th"
        android:imeSubtypeLocale="th_TH"
        android:languageTag="th-TH"
        android:imeSubtypeMode="keyboard"
        android:overridesImplicitlyEnabledSubtype="true" />
    <subtype
        android:label="@string/subtype_en"
        android:imeSubtypeLocale="en_US"
        android:languageTag="en-US"
        android:imeSubtypeMode="keyboard"
        android:overridesImplicitlyEnabledSubtype="true" />
</input-method>
